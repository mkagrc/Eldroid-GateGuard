<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Eldroid"
        tools:targetApi="31">

        <!-- SplashActivity — entry point -->
        <activity
            android:name="com.example.eldroid.splash.SplashActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.eldroid.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.eldroid.auth.SignupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.eldroid.dashboard.MainActivity"
            android:exported="false" />

        <activity
            android:name="com.example.eldroid.alert.AlertActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.example.eldroid.detection.HistoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.eldroid.forgotpass.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.eldroid.forgotpass.ChangePasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.eldroid.detection.ReportsActivity"
            android:exported="false" />

        <activity
            android:name="com.example.eldroid.devices.DevicesActivity"
            android:exported="false" />

        <activity
            android:name="com.example.eldroid.security.GuardsActivity"
            android:exported="false" />

        <activity
            android:name="com.example.eldroid.security.CreateSecurityActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.eldroid.profile.ProfileActivity"
            android:exported="false" />

    </application>

</manifest>
